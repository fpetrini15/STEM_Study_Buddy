#!/bin/sh
# Run data lint/tests when related files are staged.

set -e

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node is not installed; skipping Lewis tests." >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

should_run_lewis=false
should_run_quiz=false

for file in $(git diff --cached --name-only); do
  case "$file" in
    data/chemistry/lewis_structures.json \
    | js/lewis.js \
    | js/lewis-answers.js \
    | js/lewis-validation.js \
    | ci/test-lewis.js)
      should_run_lewis=true
      ;;
    data/*.json \
    | data/*/*.json \
    | images/* \
    | images/*/* \
    | images/*/*/* \
    | ci/test-quiz-data.js)
      should_run_quiz=true
      ;;
  esac
done

if [ "$should_run_lewis" = false ] && [ "$should_run_quiz" = false ]; then
  exit 0
fi

if [ "$should_run_lewis" = true ]; then
  echo "pre-commit: running Lewis structure tests..."
  node ci/test-lewis.js
fi

if [ "$should_run_quiz" = true ]; then
  echo "pre-commit: running quiz data tests..."
  node ci/test-quiz-data.js
fi
